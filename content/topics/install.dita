<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="install">
  <title>Installing <ph keyref="product-name"/></title>
  <shortdesc>Install the <ph keyref="product-name"/> agent on your workstation.</shortdesc>
  <taskbody>
    <prereq>
      <note conref="../shared/reuse.dita#reuse/warn-power"/>
    </prereq>
    <steps>
      <step><cmd>Download the installer for version <ph keyref="product-version"/>.</cmd></step>
      <step platform="mac"><cmd>Open <filepath>AcmeWidget.dmg</filepath> and drag the app to
          <filepath>Applications</filepath>.</cmd></step>
      <step platform="windows"><cmd>Run <filepath>AcmeWidgetSetup.exe</filepath> and follow the
          wizard.</cmd></step>
      <step platform="linux"><cmd>Run <codeph>sudo dpkg -i acme-widget.deb</codeph>.</cmd></step>
      <step audience="admin"><cmd>Register the device with your fleet license key.</cmd>
        <info><p>Find the license key in the admin console under
            <uicontrol>Billing</uicontrol>.</p></info></step>
      <step conkeyref="reuse/step-restart"><cmd/></step>
    </steps>
    <result><p>The <ph keyref="product-name"/> icon appears in the menu bar.</p></result>
  </taskbody>
</task>
