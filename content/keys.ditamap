<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Shared key definitions: product variables and external links. Used by every guide. -->
<map>
  <title>Shared key definitions</title>

  <!-- Text variables -->
  <keydef keys="product-name"><topicmeta><keywords><keyword>CorgiBase</keyword></keywords></topicmeta></keydef>
  <keydef keys="product-release"><topicmeta><keywords><keyword>2026.10</keyword></keywords></topicmeta></keydef>
  <keydef keys="company"><topicmeta><keywords><keyword>CorgiBase, Inc.</keyword></keywords></topicmeta></keydef>
  <keydef keys="mobile-app"><topicmeta><keywords><keyword>CorgiBase Kennel</keyword></keywords></topicmeta></keydef>
  <keydef keys="api-version"><topicmeta><keywords><keyword>v2</keyword></keywords></topicmeta></keydef>
  <keydef keys="api-base-url"><topicmeta><keywords><keyword>https://api.corgibase.example/v2</keyword></keywords></topicmeta></keydef>
  <keydef keys="support-email"><topicmeta><keywords><keyword>support@corgibase.example</keyword></keywords></topicmeta></keydef>
  <keydef keys="rate-limit"><topicmeta><keywords><keyword>600</keyword></keywords></topicmeta></keydef>

  <!-- External links -->
  <keydef keys="app-url" href="https://app.corgibase.example" scope="external" format="html">
    <topicmeta><linktext>app.corgibase.example</linktext></topicmeta>
  </keydef>
  <keydef keys="support-url" href="https://support.corgibase.example" scope="external" format="html">
    <topicmeta><linktext>CorgiBase Support</linktext></topicmeta>
  </keydef>
  <keydef keys="status-url" href="https://status.corgibase.example" scope="external" format="html">
    <topicmeta><linktext>status.corgibase.example</linktext></topicmeta>
  </keydef>
  <keydef keys="api-guide" href="https://simonlaraway.github.io/DITA-mockup/api/index.html" scope="external" format="html">
    <topicmeta><linktext>CorgiBase API Guide</linktext></topicmeta>
  </keydef>

  <!-- Reuse warehouse, addressed by key for conkeyref -->
  <keydef keys="reuse" href="shared/reuse.dita" processing-role="resource-only"/>
</map>
